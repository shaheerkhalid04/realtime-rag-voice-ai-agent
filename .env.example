# Copy to .env.local and fill in. Every key below has a free tier.

# https://app.pinecone.io  ->  API Keys
# Pinecone stores the vectors and also hosts the embedding model, so it is the
# only retrieval dependency.
PINECONE_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://dashboard.vapi.ai  ->  API Keys  ->  Public Key
# Safe to expose: it only authorises starting a web call from the browser. It is
# read by the backend and handed to the page by /api/py/health, so rotating it
# does not need a rebuild. (A build-time NEXT_PUBLIC_VAPI_PUBLIC_KEY is still
# honoured if you prefer that, and takes precedence.)
VAPI_PUBLIC_KEY=

# The public HTTPS origin Vapi should call for the RAG-backed language model.
# Vapi's servers reach this, not the browser, so localhost will not work - point
# it at the deployed app (or an ngrok tunnel) even while developing locally.
# Example: https://your-app.vercel.app
NEXT_PUBLIC_RAG_LLM_ORIGIN=

# --- Optional --------------------------------------------------------------
# Shared secret sent by Vapi as the x-vapi-secret header. Set it in both places
# to reject anything else that finds the custom-LLM endpoint.
# VAPI_SERVER_SECRET=

# PINECONE_INDEX=voice-rag
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# EMBED_MODEL=llama-text-embed-v2
# EMBED_DIMENSION=1024
# GROQ_MODEL=openai/gpt-oss-120b

# Required for adding or deleting documents. Unset means writes are off.
ADMIN_TOKEN=

# Optional: an assistant built in the Vapi dashboard (custom LLM plus x-vapi-secret header).
# VAPI_ASSISTANT_ID=
# TOP_K=5
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
